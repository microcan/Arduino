    "scriptCfg": {
      "data": "-- run script at 50Hz\nsetTickRate(10)\n\n-- add a calculated channels\ng_idOil = addChannel(\"OilPress\", 10, 1, 0, 10, \"Bar\")\n\n-- calculate a smoothed oil pressure value\ng_smooth = 0\nfunction smoothOil()\n  local new = getAnalog(6)\n  g_smooth = 0.9 * g_smooth + 0.1 * new\n  --println(\"raw:\" ..new ..\" smooth:\" ..smooth)\n  setChannel(g_idOil, g_smooth)\nend\n\n--make a fake rpm for testing\ng_count = 0\ng_delta = 100\ng_fakeRpm = 4000\nfunction getFakeRpm()\n  g_count = g_count +1\n  if g_count == 4 then\n    if g_fakeRpm >= 7400 then\n      g_delta = -100\n    end\n    if g_fakeRpm <= 4000 then\n       g_delta = 100\n    end\n    g_fakeRpm = g_fakeRpm + g_delta\n    g_count = 0\n    println(g_fakeRpm)\n  end\n  return g_fakeRpm\nend\n\n--update the light strip\nfunction setLightsGYR(g, y, r)\n  red = 0\n  yellow = 1\n  green = 2\n  setGpio(green, g)\n  setGpio(yellow, y)\n  setGpio(red, r)\nend\n\ng_rpm = 0\nfunction readRPM()\n  done = 0\n  repeat\n    --println(\"readRPM repeat\")\n    id, ext, data = rxCAN(0, 1000)\n    if id == 2024 then\n      done = 1\n      --print(\"id: \" ..id ..\" - \")\n      --for i = 1,#data do\n      --  print(data[i] ..\", \")\n      --end\n      --println(\"\")\n      g_rpm = (data[4] * 256 + data[5])/4\n      --println(\"rpm: \"..rpm)\n    end\n  until done > 0\nend\n\ng_flash = 0\nfunction updateLights()\n  on = 1\n  off = 0\n  if g_flash == 0 then g_flash = 1 else g_flash = 0 end\n  flash = g_flash\n\n  --rpm = getFakeRpm()\n  --rpm = getChannel(\"RPM\")\n  readRPM()\n  rpm = g_rpm\n  --println(\"rpm: \"..rpm)\n  if rpm <= 5000 then\n    setLightsGYR(off, off, off)\n  elseif rpm <= 6000 then\n    setLightsGYR(on, off, off)\n  elseif rpm <= 6500 then\n    setLightsGYR(off, on, off)\n  elseif rpm <= 7000 then\n    setLightsGYR(off, off, on)\n  else\n    setLightsGYR(flash, flash, on)\n  end \nend\n\nfunction outputCAN()\n  repeat\n    id, ext, data = rxCAN(0, 1000)\n    if id == 212 then\n      print(\"id: \" ..id ..\" - \")\n      for i = 1,#data do\n        print(data[i] ..\", \")\n      end\n      println(\"\")\n    end\n  until id == nil\nend\n\nfunction unknownCAN()\n  repeat\n    id, ext, data = rxCAN(0, 1000)\n    if ((id ~= 320) and (id ~= 209)\n        and (id ~= 321) and (id ~= 24)\n        and (id > 899) and (id < 10000)) then\n      print(\"id: \" ..id ..\" - \")\n      for i = 1,#data do\n        print(data[i] ..\", \")\n      end\n      println(\"\")\n    end\n  until id == nil\nend\n\n-- tick\nfunction onTick() \n  --println(\"on tick\")\n  smoothOil()\n  updateLights()\n  --outputCAN()\n  --unknownCAN()\nend",
      "page": null
    },
